{
  "name": "ingbelg-in-motion",
  "version": "1.0.9",
  "description": "INGBELG NL/FR \u2014 roofing and renovation web app",
  "private": true,
  "type": "module",
  "main": "server.mjs",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && vite build --config vite.prerender.config.ts && node scripts/build-seo.mjs",
    "start": "node server.mjs",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "0.186.1",
    "@react-three/fiber": "9.8.1",
    "@react-three/drei": "10.7.9",
    "lucide-react": "1.31.0",
    "radix-ui": "1.6.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "vite": "8.0.13",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.186.0",
    "@tailwindcss/postcss": "4.2.1",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "1.4.0"
  }
}
